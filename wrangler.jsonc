{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claude-cascade",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "SOURCES": [
      { "id": "throne-a", "urlSecret": "UPSTREAM_A", "requiresHwid": true },
      { "id": "throne-b", "urlSecret": "UPSTREAM_B", "requiresHwid": true }
    ]
  }
}
