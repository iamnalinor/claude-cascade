{
  "log": { "loglevel": "warning", "access": "none" },
  "inbounds": [
    {
      "tag": "exit-in",
      "listen": {{ configured_exit_listen | to_json }},
      "port": {{ configured_exit_port | int }},
      "protocol": "vless",
      "settings": {
        "decryption": "none",
        "clients": [{ "id": {{ exit_material.uuid | to_json }} }]
      },
      "streamSettings": {
        "network": "raw",
{% if configured_exit_security == 'tls' %}
        "security": "tls",
        "tlsSettings": {
          "minVersion": "1.3",
          "certificates": [{
            "certificateFile": "/etc/happ-exit/tls/server.crt",
            "keyFile": "/etc/happ-exit/tls/server.key"
          }]
        }
{% else %}
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": {{ (reality_target_host ~ ':' ~ configured_reality_target_port) | to_json }},
          "serverNames": [{{ reality_server_name | to_json }}],
          "shortIds": [{{ exit_material.short_id | to_json }}]
        }
{% endif %}
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "exit-internet" },
    { "protocol": "blackhole", "tag": "exit-block" }
  ],
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [{ "type": "field", "ip": ["geoip:private"], "outboundTag": "exit-block" }]
  }
}
